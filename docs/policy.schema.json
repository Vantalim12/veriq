{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "reviewed_on": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Reviewed On",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        }
      },
      "required": [
        "reviewer",
        "reviewed_on"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "approved": {
          "$ref": "#/$defs/Approval"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gate_node_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gate Node Id"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "not_applicable_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Applicable Reason"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "must_pass_through",
            "forbid_path",
            "require_condition"
          ],
          "title": "Type",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "severity",
        "approved"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "source_node_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "source_node_id",
        "target_node_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$id": "urn:veriq:policy:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fields": {
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$": {
          "enum": [
            "number",
            "string"
          ],
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 128
      },
      "title": "Fields",
      "type": "object"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "minimum": 1,
      "title": "Policy Version",
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_document": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Document"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "rules"
  ],
  "title": "Policy",
  "type": "object"
}
