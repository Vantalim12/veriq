# Veriq keeps its current Appwrite URL. Clerk needs a domain you own with DNS access.
# Replace both Clerk URLs with the exact production discovery values before enabling.
VERIQ_ENVIRONMENT=production
VERIQ_CLERK_PUBLISHABLE_KEY=
VERIQ_PUBLIC_ORIGIN=https://veriq.sgp.appwrite.run
VERIQ_OAUTH_ISSUER=https://clerk.your-owned-domain.example
VERIQ_JWKS_URL=https://clerk.your-owned-domain.example/.well-known/jwks.json
VERIQ_UPLOAD_CLIENT_ID=replace-with-production-public-client-id
VERIQ_APPWRITE_DATABASE=veriq
VERIQ_APPWRITE_BUCKET=veriq-private
# Mark this variable secret. Never place a real key in this file.
VERIQ_APPWRITE_API_KEY=replace-with-private-server-key
VERIQ_OPENAI_DOMAIN_TOKEN=
