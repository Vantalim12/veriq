# Appwrite supplies APPWRITE_FUNCTION_API_ENDPOINT and APPWRITE_FUNCTION_PROJECT_ID.
# Use the function's HTTPS domain; no path or trailing slash.
VERIQ_PUBLIC_ORIGIN=https://replace-with-function-domain.appwrite.run
VERIQ_OAUTH_ISSUER=https://your-tenant.us.auth0.com/
VERIQ_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
VERIQ_APPWRITE_DATABASE=veriq
VERIQ_APPWRITE_BUCKET=veriq-private
# Configure as a secret function variable, never commit a real value.
VERIQ_APPWRITE_API_KEY=replace-with-private-server-key
