# Appwrite supplies APPWRITE_FUNCTION_API_ENDPOINT and APPWRITE_FUNCTION_PROJECT_ID.
# Pilot configuration only. See production.env.example before public launch.
VERIQ_ENVIRONMENT=development
# Use the function's HTTPS domain; no path or trailing slash.
VERIQ_PUBLIC_ORIGIN=https://veriq.sgp.appwrite.run
VERIQ_OAUTH_ISSUER=https://large-bluebird-4071.clerk.accounts.dev
VERIQ_JWKS_URL=https://large-bluebird-4071.clerk.accounts.dev/.well-known/jwks.json
# Public OAuth client; register the exact /upload/callback URI in Clerk.
VERIQ_UPLOAD_CLIENT_ID=RG1VUYAaWua4aGng
VERIQ_APPWRITE_DATABASE=veriq
VERIQ_APPWRITE_BUCKET=veriq-private
# Configure as a secret function variable, never commit a real value.
VERIQ_APPWRITE_API_KEY=replace-with-private-server-key
