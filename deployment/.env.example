# Docker-host option; this does not configure an Appwrite Cloud runtime.
VERIQ_ENVIRONMENT=development
# Optional: Clerk public pk_test_/pk_live_ key to show the embedded sign-in form.
VERIQ_CLERK_PUBLISHABLE_KEY=
# Copy to deployment/.env and replace the hostname and Clerk discovery values.
VERIQ_DOMAIN=veriq.example.com
VERIQ_OAUTH_ISSUER=https://large-bluebird-4071.clerk.accounts.dev
VERIQ_JWKS_URL=https://large-bluebird-4071.clerk.accounts.dev/.well-known/jwks.json
VERIQ_UPLOAD_CLIENT_ID=RG1VUYAaWua4aGng
VERIQ_OPENAI_DOMAIN_TOKEN=
