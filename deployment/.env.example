# Docker-host option; this does not configure an Appwrite Cloud runtime.
# Copy to deployment/.env and replace the hostname and Auth0 discovery values.
VERIQ_DOMAIN=veriq.example.com
VERIQ_OAUTH_ISSUER=https://your-tenant.us.auth0.com/
VERIQ_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
